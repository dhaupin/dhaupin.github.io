# Project npm config (web/) - the family's npmrc law, placed where the
# Pages build reads it.
#
# The portfolio's Cloudflare Pages project roots npm at web/ (DEPLOY.md
# section 2), so the builder reads THIS file, not the repo root's - the
# same reason vant mirrors its .npmrc into web/home and web/dashboard.
#
# legacy-peer-deps=true - the npm 10.x arborist optional-peer-set crash
# (npm/cli#9787, "Cannot read properties of null (reading 'edgesOut')")
# fires under registry drift on npm 10.9.x over peer blocks shaped like
# vite 8's optional @vitejs/devtools siblings. The CF v3 build image
# ships npm 10.9.9, and vant reproduced the crash verbatim on a Pages
# deploy of the same vite-8 graph. Our committed lockfile is complete and
# `npm ci` is a no-op for this flag; it only matters if the builder is
# forced to re-resolve (stale lock), which is exactly the failure mode
# vant hit. The root graph (docs tooling) has no such peer shape, so the
# repo root needs no .npmrc.
legacy-peer-deps=true
